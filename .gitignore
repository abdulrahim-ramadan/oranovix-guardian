# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environment ────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Build / distribution ───────────────────────────────────────────────────
dist/
build/
release/
*.egg-info/
*.egg
*.spec

# ── Compiled executables ───────────────────────────────────────────────────
*.exe
*.msi
*.app

# ── Runtime data (generated at runtime, not source) ───────────────────────
scan_history.db
scan_history.db-shm
scan_history.db-wal
settings.json
/rules/custom_rules.json
osv.db
osv.db.new
integrity.db
integrity.db-journal
feed.db
feed.db-journal
reports/output/

# ── Secrets / local config ────────────────────────────────────────────────
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# ── IDE / editor ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Test artefacts ────────────────────────────────────────────────────────
/test_vuln.*
.pytest_cache/
.coverage
htmlcov/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log

# Generated PDF reports
*security_report*.pdf

# ── Test corpus (intentionally vulnerable fixtures, must stay tracked) ────
!src/tests/corpus/**
src/tests/corpus/**/__pycache__/

